# FlowDesk environment configuration.
# Copy to .env.local for local development.

# Controls whether the database is seeded from lib/seed-data on first run.
#   true  (default) — seed the empty database with the demo dataset
#   false           — never seed; existing .data/flowdesk.db rows are untouched
#
# To go to production without mock data: set SEED=false (or delete .data/),
# then delete the lib/seed-data directory — nothing else in the app reads it.
SEED=true
